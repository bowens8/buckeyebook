rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isMe(uid) { return request.auth.uid == uid; }
    function isCommissioner() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/players/$(request.auth.uid)).data.isCommissioner == true;
    }

    // Everyone can read the roster/standings. Players can edit their own
    // doc as always; balance/allTimeNet updates to OTHER players are also
    // allowed from any signed-in user now, not just the commissioner —
    // that's what lets the live data engine's auto-settlement run from
    // whichever player's device happens to be polling when a game ends.
    // TRADE-OFF: this means any signed-in player's client can, in
    // principle, write directly to another player's balance — there's no
    // server backstop verifying the settlement math anymore. Acceptable
    // for a closed friend-group app running on trust; if that ever stops
    // being true, tighten this back to isMe(uid) || isCommissioner().
    match /players/{uid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isMe(uid);
      allow update: if isSignedIn();
    }

    // Games: readable by all, writable by any signed-in user — this is
    // what lets any player's device act as the live-data engine (score
    // polling, spread locking, settlement) rather than requiring a
    // specific commissioner tab to be open.
    match /games/{gameId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Picks: anyone can read the board; a player can only create their OWN
    // pick, and can edit or cancel it themselves before kickoff while
    // unsettled. Marking a pick settled (auto-settlement) is allowed from
    // any signed-in user for the same reason as games above — whichever
    // device is polling drives the payout math.
    match /picks/{pickId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.playerId == request.auth.uid;
      allow update: if isSignedIn();
      allow delete: if isCommissioner() || (
        isSignedIn() &&
        resource.data.playerId == request.auth.uid &&
        resource.data.settled == false &&
        request.time.toMillis() < get(/databases/$(database)/documents/games/$(resource.data.gameId)).data.kickoffMs
      );
    }

    // Live bets: any signed-in player can propose; the proposer can move
    // the posted `odds` field while it's still open (in-game lines are
    // meant to shift), or the commissioner can change status to settle it.
    match /live_bets/{betId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.proposedBy == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.proposedBy == request.auth.uid || isCommissioner());
    }

    // Each response doc belongs to exactly one invited/joining player —
    // this is what lets everyone accept/decline in parallel with no shared write.
    match /live_bet_responses/{responseId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        (request.resource.data.playerId == request.auth.uid || isCommissioner());
      allow update: if isSignedIn() && resource.data.playerId == request.auth.uid;
    }

    // Sync settings (which divisions/conferences to pull) — readable by
    // any signed-in user, since the auto-sync engine running on ANY
    // device needs to read this to know what to pull. Only the
    // commissioner can change it.
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isCommissioner();
    }

    // Ledger entries are an append-only audit trail.
    match /ledger/{entryId} {
      allow read: if isSignedIn() && resource.data.playerId == request.auth.uid;
      allow create: if isSignedIn();
    }
  }
}
