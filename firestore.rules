rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isMe(uid) { return request.auth.uid == uid; }
    function isCommissioner() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/players/$(request.auth.uid)).data.isCommissioner == true;
    }

    // Everyone can read the roster/standings; players can only edit their own doc,
    // and balance/leaf edits happen via transactions run from the client SDK.
    match /players/{uid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isMe(uid);
      allow update: if isSignedIn() && (isMe(uid) || isCommissioner());
    }

    // Games are commissioner-managed, readable by all.
    match /games/{gameId} {
      allow read: if isSignedIn();
      allow write: if isCommissioner();
    }

    // Picks: anyone can read the board; a player can only create their OWN
    // pick. They can also edit or cancel their own pick, but only before
    // kickoff and only while it's unsettled — the moment the game starts,
    // this falls through to commissioner-only, same hard lock as picks.js
    // enforces in the UI. Belt-and-suspenders: even a modified client
    // can't sneak an edit through after kickoff.
    match /picks/{pickId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.playerId == request.auth.uid;
      allow update, delete: if isCommissioner() || (
        isSignedIn() &&
        resource.data.playerId == request.auth.uid &&
        resource.data.settled == false &&
        request.time.toMillis() < get(/databases/$(database)/documents/games/$(resource.data.gameId)).data.kickoffMs
      );
    }

    // Live bets: any signed-in player can propose; the proposer can move
    // the posted `odds` field while it's still open (in-game lines are
    // meant to shift), or the commissioner can change status to settle it.
    match /live_bets/{betId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.proposedBy == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.proposedBy == request.auth.uid || isCommissioner());
    }

    // Each response doc belongs to exactly one invited/joining player —
    // this is what lets everyone accept/decline in parallel with no shared write.
    match /live_bet_responses/{responseId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        (request.resource.data.playerId == request.auth.uid || isCommissioner());
      allow update: if isSignedIn() && resource.data.playerId == request.auth.uid;
    }

    // Ledger entries are an append-only audit trail.
    match /ledger/{entryId} {
      allow read: if isSignedIn() && resource.data.playerId == request.auth.uid;
      allow create: if isSignedIn();
    }
  }
}
